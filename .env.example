# Copiez ce fichier en « .env.local » pour lancer le site sur votre ordinateur.
# Sur Vercel : Settings > Environment Variables (mêmes noms).

# --- Supabase (Project Settings > API, ou bouton « Connect ») ---------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé « anon » ou « publishable ». JAMAIS la clé « service_role » / « secret ».
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# --- Adresse publique du site (sans / final) --------------------------------
# Sert au sitemap, aux aperçus WhatsApp / réseaux sociaux et aux liens canoniques.
NEXT_PUBLIC_SITE_URL=https://edm-republique.vercel.app

# --- Tâche quotidienne anti-pause Supabase (Vercel Cron) -------------------
# Une longue phrase inventée, sans espaces.
CRON_SECRET=une-longue-phrase-secrete-au-hasard

# --- Formulaire de contact (FACULTATIF) -----------------------------------
# Sans ces trois variables, le formulaire n'apparaît pas : la page Contact
# affiche seulement l'email, le téléphone et WhatsApp.
# Service d'envoi : https://resend.com (offre gratuite).
RESEND_API_KEY=
# Adresse qui reçoit les messages du formulaire
CONTACT_TO_EMAIL=
# Expéditeur validé chez Resend, ex. « EDM République <contact@votre-domaine.fr> »
# (pour tester sans domaine : onboarding@resend.dev, envoi vers votre propre adresse Resend uniquement)
CONTACT_FROM_EMAIL=
